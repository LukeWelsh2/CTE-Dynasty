# --- Database (PostgreSQL) ---
DATABASE_URL="postgresql://cte:cte@localhost:5432/cte_dynasty?schema=public"

# --- App ---
# Public URL of the site (used in emails, push notification links)
APP_URL="http://localhost:3000"
# Random 32+ char string used to sign session cookies / tokens
AUTH_SECRET="change-me-to-a-long-random-string"

# --- Background jobs ---
# Set to "false" to disable the in-process scheduler (e.g. when running a separate worker)
JOBS_ENABLED="true"
# Live scoring poll interval during games (seconds)
LIVE_POLL_SECONDS="20"
# Use a simulated live feed (for demos / offseason testing): "true" | "false"
SIMULATED_LIVE="false"

# --- Email (SMTP) for weekly recaps, password resets, trade alerts ---
# Works with any SMTP provider (Resend, Postmark, SendGrid, Gmail app password, ...)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="CTE Dynasty <commish@example.com>"
# When SMTP_HOST is empty, emails are written to ./.emails/ and viewable at /admin/emails

# --- Web Push (phone notifications) ---
# Generate with: npm run vapid
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:commish@example.com"

# --- Optional SMS fallback via Twilio ---
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""
