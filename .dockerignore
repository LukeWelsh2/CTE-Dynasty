# Keep the build context small and never bake secrets or local data into the image.

# VCS / editors / OS
.git
.gitignore
.github
.vscode
.idea
.claude
.DS_Store
*.log
npm-debug.log*

# Dependencies and build output (rebuilt inside the image)
node_modules
.next
out
coverage
*.tsbuildinfo
next-env.d.ts

# Secrets and local runtime data
.env
.env.*
.emails
public/uploads/*
!public/uploads/.gitkeep

# Not needed to build or run the app
docs
tests
README.md
CLAUDE.md
Dockerfile
docker-compose.yml
.dockerignore
